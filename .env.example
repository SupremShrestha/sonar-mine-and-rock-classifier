# Copy this file to .env and fill in what you need. .env is ignored by Git.
# For local development you can leave everything below empty or omit it.

# --- Email (optional) ---
# Without these, password-reset emails are printed in the terminal.
# For Gmail, use an App Password (Google Account > Security > App passwords).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Production only (real server) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=generate-one-see-README
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_BEHIND_PROXY=True
